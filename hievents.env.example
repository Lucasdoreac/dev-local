# Chaves GERADAS LOCALMENTE (dev). Fora de qualquer repo.
# Copie para hievents.env e gere APP_KEY/JWT_SECRET localmente.
APP_KEY=
JWT_SECRET=
VITE_FRONTEND_URL=http://localhost:8123
VITE_API_URL_CLIENT=http://localhost:8123/api
VITE_API_URL_SERVER=http://localhost:80/api
LOG_CHANNEL=stderr
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local
APP_CDN_URL=http://localhost:8123/storage
VITE_STRIPE_PUBLISHABLE_KEY=
