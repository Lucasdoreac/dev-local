# Official MinIO Community Edition security source release, cross-compiled in
# a Linux builder and packaged on the official UBI micro base used upstream.
FROM --platform=$BUILDPLATFORM golang:1.24.8-alpine@sha256:3d78beb141d98f42337f1252ecf2a5f20374109929a4c3f6817f9e4179cc0ae5 AS build

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a

ENV CGO_ENABLED=0
WORKDIR /src

RUN apk add --no-cache ca-certificates git && \
    git clone --depth 1 --branch "$MINIO_RELEASE" https://github.com/minio/minio.git /src && \
    test "$(git rev-parse HEAD)" = "$MINIO_COMMIT"

RUN mkdir -p /out && \
    LDFLAGS="$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go 2025-10-15T17-29-55Z)" && \
    GOOS=linux GOARCH="$TARGETARCH" go build -tags kqueue -trimpath \
      --ldflags "$LDFLAGS" -o /out/minio .

FROM registry.access.redhat.com/ubi9/ubi-micro:latest@sha256:7a0454cbd9bd847e8f6a63b6f0254a6efbeb6e0ed71a5d824a4f6cccbe626650

ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
LABEL name="MinIO" \
      vendor="MinIO Inc <dev@min.io>" \
      version="$MINIO_RELEASE" \
      summary="MinIO Object Storage built from its official security release source"

ENV MINIO_ACCESS_KEY_FILE=access_key \
    MINIO_SECRET_KEY_FILE=secret_key \
    MINIO_ROOT_USER_FILE=access_key \
    MINIO_ROOT_PASSWORD_FILE=secret_key \
    MINIO_KMS_SECRET_KEY_FILE=kms_master_key \
    MINIO_CONFIG_ENV_FILE=config.env \
    MC_CONFIG_DIR=/tmp/.mc

RUN chmod -R 777 /usr/bin
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/minio /usr/bin/minio
COPY --from=build /src/CREDITS /licenses/CREDITS
COPY --from=build /src/LICENSE /licenses/LICENSE
COPY --from=build /src/dockerscripts/docker-entrypoint.sh /usr/bin/docker-entrypoint.sh

EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio"]
