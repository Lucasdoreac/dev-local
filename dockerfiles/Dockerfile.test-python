FROM --platform=linux/amd64 docker:cli@sha256:b1805116a6a86cc591b5d5f60a910a0715cdcc9d18d866ad68b1457ead25c35c AS docker_cli

# Pin the official Python amd64 child manifest to avoid reusing another platform.
FROM python:3.14.7-slim@sha256:7bf6c3111fe094f8ee1a1cbcdc63c4cfb345b0e3df42d5aa9a90b3b4b022ab6d

ARG POETRY_VERSION=2.4.1
ARG DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Older locked wheels may not publish a CPython 3.14 build. Keep test-only
# native build tools in the disposable runner image, not in application images.
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && apt-get install --no-install-recommends --yes \
        build-essential \
        libffi-dev \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}"

# The harness self-tests resolve Compose configuration inside this Linux runner.
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
